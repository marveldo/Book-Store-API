# Copy to .env and fill in. Never commit .env.
# Real environment variables (e.g. set on Render) override values in .env.

# ---- Server ----
PORT=10000                 # Render expects 10000; listen on 0.0.0.0
THREADS=4                  # Drogon IO threads
APP_ENV=development        # development | production

# ---- Database (PostgreSQL) ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bookstore
DB_SCHEMA=public
DB_USER=postgres
DB_PASSWORD=
DB_CONNECTIONS=4           # connection pool size
# Or one URL instead of DB_HOST..DB_PASSWORD (encode special characters in the password, @ -> %40):
# DB_URL=postgresql://user:password@host:5432/dbname
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_EXPIRATION=

#------EMAIL(RESEND)----
RESEND_API_KEY=
EMAIL_FROM=

#------- Background Tasks --------
QUEUE_MAX_ATTEMPTS=5
QUEUE_MAX_IN_FLIGHT=1000
REDIS_PORT=6379
REDIS_HOST=
REDIS_PASSWORD=
REDIS_USERNAME=            # only for a Redis ACL user other than "default"
REDIS_DB=0
# Or one URL instead of the REDIS_* fields above (must be redis://, not rediss://):
# REDIS_URL=redis://default:password@host:6379/0

#------ PDF uploads -------
PDF_MAX_MB=20              # biggest PDF accepted by POST /books/{id}/pdf
PDF_MAX_PAGES=2000         # longer PDFs fail with a clear error
PDF_TIMEOUT_SECONDS=600    # give up on a PDF that takes longer than this
PDF_MAX_IMAGES=300         # pictures and image pages per book; later ones are left out
PDF_MAX_CONCURRENT=1       # PDF imports running at once per server; others wait in Redis

#-----  Cloudinary-------
ASSETS_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

# ---- Migrations (golang-migrate) ----
# migrate -path migrations -database "$DATABASE_URL" up
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/bookstore?sslmode=disable
