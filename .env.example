# Copy to .env and fill in. Never commit .env.
# Real environment variables (e.g. set on Render) override values in .env.

# ---- Server ----
PORT=10000                 # Render expects 10000; listen on 0.0.0.0
THREADS=4                  # Drogon IO threads
APP_ENV=development        # development | production

# ---- Database (PostgreSQL) ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bookstore
DB_SCHEMA=public
DB_USER=postgres
DB_PASSWORD=
DB_CONNECTIONS=4           # connection pool size
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_EXPIRATION=

# ---- Migrations (golang-migrate) ----
# migrate -path migrations -database "$DATABASE_URL" up
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/bookstore?sslmode=disable
